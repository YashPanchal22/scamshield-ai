# ---- Frontend (frontend/.env) ----
# Leave empty for local dev (Vite proxies /api to 127.0.0.1:8000).
# In production, set to your deployed FastAPI origin, e.g. https://api.example.com
VITE_API_BASE=

# ---- Backend (environment of the FastAPI process) ----
# Optional LLM for richer assistant answers (server-side only; empty = rule-based fallback)
OPENAI_API_KEY=
# Optional Supabase (Postgres + Auth) for accounts/persistent history (empty = guest mode, no server storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=""
